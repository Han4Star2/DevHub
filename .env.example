DATABASE_URL="postgres://devhub:devhub@localhost:5432/devhub"
# Only needed when DATABASE_URL points at a pooled connection (e.g. Supabase's
# pgbouncer transaction pooler on port 6543) - migrations need a direct,
# non-pooled connection. Leave unset for a plain local Postgres.
DIRECT_URL=""
ROBLOX_API_BASE="https://games.roblox.com"
ROBLOX_THUMBNAILS_API_BASE="https://thumbnails.roblox.com"
CRON_SECRET="change-me"

# Required for "Sign in with Roblox". See README's Roblox OAuth section for
# where to get these. Without them, the button fails gracefully with a
# "not set up yet" message instead of crashing.
APP_BASE_URL="http://localhost:3000"
ROBLOX_OAUTH_CLIENT_ID=""
ROBLOX_OAUTH_CLIENT_SECRET=""
